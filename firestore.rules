rules_version = '2';

// families/main: the one shared tree doc — any signed-in relative can read/write it.
// families/relationshipOverrides: custom Tamil relationship-term rules, same
//   any-signed-in-relative access as families/main.
// users/{uid}: personal prefs (meId, rootId, cached login email, notification
//   opt-in) — only that account can touch its own doc, EXCEPT admins, who can
//   also read/write everyone's (see AdminPanel's "Linked Accounts" view and
//   account-fixing needs).
// settings/admins, settings/app: admin-managed config — any signed-in user can read
//   (so the client can check its own admin status / apply feature flags), but only
//   an existing admin can write. Mirrors src/hooks/useAdmin.js's PERMANENT_ADMIN_EMAILS.
// birthdayWishes/{wishId}: one doc per wish left on a person's profile — anyone
//   signed in can read/leave one, but only the author (or an admin) can delete
//   it, and nobody can edit one after posting (matches how a birthday wish
//   works in real life — you can take it back, not rewrite it later).
// Everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['manikandan.ks.14@gmail.com'] ||
        (
          exists(/databases/$(database)/documents/settings/admins) &&
          request.auth.token.email in get(/databases/$(database)/documents/settings/admins).data.emails
        )
      );
    }

    match /families/main {
      allow read, write: if request.auth != null;
    }

    // Self-service Tamil relationship-term corrections — any signed-in
    // relative can add/remove a rule, matching families/main's own
    // permissiveness (the whole point is fixing a wrong term yourself
    // without needing an admin; mistakes are visible/reversible in the
    // Relationship Rules panel).
    match /families/relationshipOverrides {
      allow read, write: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /birthdayWishes/{wishId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.fromUid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /settings/admins {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /settings/app {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
